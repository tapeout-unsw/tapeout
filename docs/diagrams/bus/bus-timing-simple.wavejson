{ signal: [
  { name: "clk", wave: "P....", period: 8, phase: 7.5 },
  { name: "cycle", wave: "2........2.......2.......2.......", data: ["C0", "C1  core 1 request", "C2  core 2 request + core 1 load", "C3  macro loads core 2's write"], phase: 0.5 },
  {},
  ["core 1  u_core0",
    { name: "state", wave: "5........5.......5.......5.......", data: ["S_EXEC", "S_MEM", "S_MEM_W", "S_FETCH"], phase: 0.5 },
    { name: "d0_req", wave: "0.........5.......0..............", data: ["1"], phase: 0.5 },
    { name: "d0_gnt", wave: "0..........5.......0.............", data: ["1"], phase: 0.5 },
  ],
  {},
  ["core 2  u_core1",
    { name: "state", wave: "3........3...............3.......", data: ["S_EXEC", "S_MEM  (waiting)", "S_FETCH"], phase: 0.5 },
    { name: "d1_req", wave: "0.........3...............0......", data: ["1"], phase: 0.5 },
    { name: "d1_gnt", wave: "0..................3.......0.....", data: ["1"], phase: 0.5 },
  ],
  {},
  ["SRAM",
    { name: "c → w → m", wave: "z..........5.....z.3.....z.......", data: ["combinational (c → w → m)", "combinational (c → w → m)"], phase: 0.5 },
    { name: "macro loading", wave: "z................5.......3.......", data: ["loading", "loading"], phase: 0.5 },
  ],
],
gaps: "| . . . . . . . | . . . . . . . | . . . . . . . |",
head: { text: "Shared bus, simple view: core 1 loads, core 2 stores one cycle later" },
foot: { text: "c = sram_mem (controller), w = sram_macro (wrapper), m = OCD SRAM macro" },
config: { hscale: 1, marks: false },
}
