edge: [
  "O<->P C2: core 1 load data comes out of Q while core 2 store goes into A, D, GWEN",
  "A~>B",
  "E-~>D waits for rr_pointer",
  "C~>D comb",
  "G<->H ta",
  "I<->J tah",
  "K<->L twh",
  "M<->N tch",
